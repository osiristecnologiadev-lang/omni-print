{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.int-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": { "^@nestjs/jwt$": "<rootDir>/src/testing/jwt-stub.ts" },
  "testEnvironment": "node",
  "maxWorkers": 1,
  "testTimeout": 30000
}
