# Copy this to .env.production (or paste these keys into the hosting
# platform's own environment variable UI - Railway/Fly.io etc. don't need
# an actual file, they read env vars directly). Never commit .env.production
# itself - see .gitignore.

# Connection string for the production Postgres/TimescaleDB instance (see
# docker-compose.yml for the local shape - production points at whatever
# the hosting platform provisions, e.g. Railway's TimescaleDB template).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omniprint"

# Signs dashboard/platform-admin login JWTs. MUST be a different value than
# the local dev secret - generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store it in a password manager, not in this file or in git.
JWT_SECRET=replace-with-a-newly-generated-64-char-hex-string

# Usually injected automatically by the hosting platform - only set this by
# hand if the platform doesn't do that.
PORT=3000

# The real deployed URL of web/ (comma-separated if there's ever more than
# one legitimate origin - e.g. a marketing site calling this API too).
# Left unset, CORS stays wide open (see main.ts) - fine for local dev,
# NOT fine for production. Must be set before going live.
CORS_ORIGIN=https://www.omniprint.app.br
