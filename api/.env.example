DATABASE_URL="postgresql://omniprint:omniprint@localhost:5432/omniprint"
PORT=3000
# Signs dashboard login JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-char-hex-string

# OmniPrint's own billing of its tenants (Stripe) - see src/subscription/.
# Secret key from the Stripe Dashboard (test mode for local dev).
STRIPE_SECRET_KEY=sk_test_...
# The Stripe Product every generated Price is attached to (Dashboard ->
# Product catalog). Prices themselves are generated inline per checkout/
# subscription-item update (price_data) rather than one fixed Price id,
# since a tenant can have its own negotiated per-device rate - see
# SubscriptionService's stripePriceData/updateTenantPricing.
STRIPE_PRODUCT_ID=prod_...
# From the Stripe Dashboard's webhook endpoint config, or `stripe listen`
# for local dev (its own temporary secret is printed on start).
STRIPE_WEBHOOK_SECRET=whsec_...
# Base URL of the web app - Checkout success/cancel redirects land here,
# and every link inside a notification digest email points back here too.
APP_URL=http://localhost:3001

# Notification digest emails (src/email/) - from resend.com's dashboard.
# Left unset, EmailService logs and skips sending instead of failing.
RESEND_API_KEY=re_...
# Must be on a domain verified in the Resend dashboard (Domains -> Add
# Domain -> DNS records at the registrar) or sends are rejected.
EMAIL_FROM="OmniPrint <notificacoes@omniprint.app.br>"

# Unhandled 5xx alerts (src/ops-alerts/) - who receives them. Left unset,
# an alert is only logged, never sent.
OPS_ALERT_EMAIL=you@example.com
# Shared secret web/'s instrumentation.ts sends alongside its own alert
# webhook call (POST /v1/ops/alert) - must match the SAME value set on
# web/'s own OPS_ALERT_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_ALERT_SECRET=replace-with-a-random-64-char-hex-string
