# OmniPrint site blocks for the Caddy of Vortex (vortex-caddy-1), which owns
# ports 80/443 on this VPS. OmniPrint never runs a proxy of its own.
#
# Lives on the VPS as /opt/vortex/dados/caddy-config/omniprint.caddy - that
# DIRECTORY is bind-mounted at /config in the container, so edits to this
# file are seen by Caddy.
#
# The hook lives in the VORTEX repo (vortex-pdv/deploy/), because Vortex's
# deploy.sh re-uploads its Caddyfile and compose on every deploy - anything
# added only on the server would be wiped:
#   - Caddyfile: `import /config/omniprint*.caddy` (a glob: with no file,
#     Vortex's Caddy still starts - Vortex never depends on OmniPrint);
#   - compose: caddy joins the external network omniprint_edge.
# Never `sed -i` the server's Caddyfile: it is a single-file bind mount, and
# a new inode leaves the container on the OLD file.
#
# Any change here (e.g. Stage 1 -> Stage 2): edit omniprint.caddy, then
#   docker exec vortex-caddy-1 caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   docker exec vortex-caddy-1 caddy reload   --config /etc/caddy/Caddyfile --adapter caddyfile
# A failed reload keeps the old config running.
#
# omniprint-web / omniprint-api are network aliases on omniprint_edge
# (deploy/vps/docker-compose.yml), unambiguous next to Vortex's services.

# ---- Production (live since 2026-11-05) -------------------------------------
omniprint.app.br {
	encode gzip
	reverse_proxy omniprint-web:3000
}

www.omniprint.app.br {
	redir https://omniprint.app.br{uri} permanent
}

# Agents + installer talk to this hostname - must not change.
api.omniprint.app.br {
	reverse_proxy omniprint-api:3000
}

# The pre-cutover test hostnames vps./api-vps. were removed in Phase 4
# (2026-11-09), together with their Cloudflare records and the Railway project.
