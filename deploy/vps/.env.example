# /opt/omniprint/.env on the VPS (chmod 600, owner root). Never commit the
# real file. Values come from Railway (`railway variable list --service api`
# etc.) except POSTGRES_PASSWORD, which is NEW: generate one with
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# api
JWT_SECRET=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=
OPS_ALERT_EMAIL=
OPS_ALERT_SECRET=

# db-backup (same R2 bucket/token as the Railway db-backup service)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
