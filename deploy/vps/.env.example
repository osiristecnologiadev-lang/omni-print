# /opt/omniprint/.env on the VPS (chmod 600, owner root). Never commit the
# real file. The live values are in /opt/omniprint/.env on the VPS (copied
# from Railway at the 2026-11-05 cutover); POSTGRES_PASSWORD is generated with
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# api
JWT_SECRET=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=
OPS_ALERT_EMAIL=
OPS_ALERT_SECRET=

# db-backup (R2 bucket omniprint-db-backups)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
