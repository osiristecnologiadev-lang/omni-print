# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - but keep the .example templates tracked (documentation, no
# real secrets), same as api/'s .env.example
.env*
!.env.example
!.env.production.example

# dev server log files (this project's own convention of piping npm run
# dev's output to a file for debugging - see other subprojects too)
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
