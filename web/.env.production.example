# Copy this to .env.production (or paste into the hosting platform's env
# var UI). Never commit .env.production itself - see .gitignore.

# The real deployed URL of api/ - every server-side fetch in lib/api.ts and
# lib/platform-api.ts is built on this. No trailing slash.
API_BASE_URL=https://api.omniprint.app.br

# MUST match api/'s own OPS_ALERT_SECRET exactly (production value, not the
# local dev one) - see web/src/instrumentation.ts.
OPS_ALERT_SECRET=replace-with-a-newly-generated-64-char-hex-string
